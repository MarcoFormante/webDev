

<section id="progetti" class="mt-20">
        <h2 class="text-cyan font-black text-xs max-lg:text-center">PROGETTI</h2>
        <p class="text-text font-extrabold text-[42px] mt-5  max-lg:text-center max-md:text-[clamp(18px,10vw,42px)]">Lavori in Evidenza</p>
        <ul class="grid grid-cols-2 gap-10 mt-10 max-lg:grid-cols-1">
            {% for project in projects %}
                <twig:ProjectCard {{...project}} />
            {% endfor %}
            
        </ul>
</section>