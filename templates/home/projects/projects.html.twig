
{% trans_default_domain 'site' %}

<section id="projects" class="mt-20">
    <h2 class="text-cyan font-black text-xs max-lg:text-center">{{"projects.h2"|trans}}</h2>
    <h3 class="text-text font-extrabold text-[42px] mt-5 max-lg:text-center max-md:text-[clamp(18px,10vw,42px)]">{{'projects.sectionDesc'|trans}}</h3>
    <ul class="grid grid-cols-2 gap-10 mt-10 max-lg:grid-cols-1">
        {% for project in projects %}
            <twig:ProjectCard {{...project}} />
        {% endfor %}
    </ul>
</section>