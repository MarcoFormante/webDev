 {% set stackArray =  [
    "HTML",
    "CSS",
    "Javascript",
    "React",
    "Next.js",
    "Typescript",
    "Node",
    "Git",
    "REST API",
    "Tailwind",
    "Responsive UI",
    "MongoDB",
    "SQL",
    "MYSQL",
    "PHP",
    "Symfony",
    "Accessibility",
] %}
   
 
 <section class="my-20" id="percorso">
        <div class="flex gap-10 h-[340px]">
            <div class="p-[30px] px-10 bg-card-light flex flex-col gap-4 rounded-[34px] h-full  w-full flex-2">
                <div class="flex items-center gap-3"> 
                    <img
                        src="{{asset('images/me.webp')}}"
                        alt="Foto di Marco Formante"
                        class="w-20 h-20 rounded-full object-cover shrink-0  transition-all duration-300 hover:scale-320 cursor-zoom-in"
                        loading="lazy"
                    /> 
                    <h2 class="text-bg font-extrabold text-[34px]">Chi sono</h2> 
                </div>
                
                <p class="text-light-text ">Sono uno sviluppatore web specializzato nella creazione di interfacce veloci, accessibili e curate nei dettagli. Utilizzo prevalentemente <strong>React</strong>, <strong>Next.js</strong> e <strong>Tailwind CSS</strong> per sviluppare interfacce utente moderne e responsive.
                    A una forte predisposizione per il Frontend affianco competenze lato server in <strong>Node.js</strong>, <strong>PHP/Symfony</strong>, che mi permettono di comprendere l'intera architettura dell'applicazione, integrare <strong>API REST</strong> e gestire l'interazione con i database.
                    Cura del codice, attenzione all'esperienza utente e rispetto dei requisiti di accessibilità sono i principi alla base di ogni progetto che realizzo.
                </p>   
            </div>

            <div class="p-[30px] px-10 bg-surface flex flex-col gap-3 rounded-[34px] h-full w-full flex-2 border border-text/10">
                <h2 class="text-text text-[34px] font-extrabold">Skill principali</h2>
                <ul class="flex w-4/5 flex-wrap gap-2">
                    {% for stackItem in stackArray %}
                        <li class="w-max px-3.5 py-[11px] text-text-soft text-[13px] rounded-[999px] border border-text/8 bg-text/7  min-w-[47px]">
                           {{stackItem}}
                        </li>
                    {% endfor %}
                   
                </ul>
            </div>
        </div>
    </section>